{
  "name": "pmc-production-management",
  "version": "1.0.0",
  "private": true,
  "description": "生产管理系统 - libSQL 作为主数据存储",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "turso": "node start-turso.js",
    "icon": "node tools/make-icon.cjs",
    "app": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "static:vendor": "esbuild node_modules/@libsql/client/lib-esm/web.js --bundle --format=esm --platform=browser --target=es2022 --minify --legal-comments=none --outfile=docs/js/vendor/libsql-web.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.pmc.production",
    "productName": "生产管理系统",
    "copyright": "生产管理系统",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!data/**",
      "!tools/**",
      "!build/**",
      "!*.md",
      "!turso.config*.json",
      "!*.log",
      "!.shots/**",
      "!启动-云库版.bat",
      "!云库版使用说明.txt",
      "!pmc.txt"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "seed",
        "filter": [
          "pmc.db*"
        ]
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/@libsql/**",
      "node_modules/libsql/**"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "生产管理系统",
      "artifactName": "生产管理系统-安装程序-${version}.${ext}",
      "uninstallDisplayName": "生产管理系统"
    },
    "portable": {
      "artifactName": "生产管理系统-免安装-${version}.${ext}"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
